# Clocked account API key (server only). Leave empty to run FixProof in replay mode.
# Create one at https://clocked.rezolve.ai (account dashboard). Never commit a real key.
CLOCKED_API_KEY=

# Optional: override the API root (default https://clocked.rezolve.ai/clocked).
CLOCKED_BASE_URL=

# Account concurrency allowance: 1 Trial, 4 Build, 8 Production, 16 Scale.
CLOCKED_CONCURRENCY=4

# Live-mode budget guards (used from the API route onward).
LIVE_DAILY_CREDIT_CAP=2000
LIVE_PER_IP_RUNS_PER_HOUR=5
