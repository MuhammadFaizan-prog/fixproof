# Clocked account API key (server only). Leave empty to run FixProof in replay mode.
# Create one at https://clocked.rezolve.ai (account dashboard). Never commit a real key.
CLOCKED_API_KEY=

# Optional: override the API root (default https://clocked.rezolve.ai/clocked).
CLOCKED_BASE_URL=

# Account concurrency allowance: 1 Trial, 4 Build, 8 Production, 16 Scale.
CLOCKED_CONCURRENCY=1

# Live-mode budget guards (used from the API route onward).
LIVE_DAILY_CREDIT_CAP=2000
LIVE_PER_IP_RUNS_PER_HOUR=5
# Live runs allowed in flight at once (keep at the account concurrency, 1 on Trial).
LIVE_MAX_INFLIGHT=1
# Credits reserved per live run before it starts; settled to X-Clocked-Credits after.
LIVE_RUN_CREDIT_ESTIMATE=60
# Hard ceiling per live run: when a run has spent this many credits it stops and is handed to a person.
LIVE_RUN_CREDIT_CEILING=90
# Without a durable store (below), each serverless instance keeps its own daily meter,
# so the daily cap is lowered to this many credits per warm instance.
LIVE_INSTANCE_CREDIT_CAP=400

# Optional durable store for one global daily credit meter across all instances
# (Upstash Redis, or Vercel's Redis/KV integration, which sets the KV_* names).
# If set but unreachable, live runs are refused (fail closed); presets still replay.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
